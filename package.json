{
  "name": "ledgerly",
  "private": true,
  "version": "1.0.0",
  "description": "Payroll and leave management: React, Express and PostgreSQL, with a tested payroll engine and role-based approvals.",
  "license": "MIT",
  "author": "Zaid Nayeem",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @ledgerly/api\" \"npm run dev -w @ledgerly/web\"",
    "dev:demo": "npm run dev:demo -w @ledgerly/web",
    "build": "npm run build -w @ledgerly/web",
    "typecheck": "tsc -p packages/domain && tsc -p packages/api && tsc -p apps/web",
    "lint": "oxlint packages/domain/src packages/api/src apps/web/src e2e",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test e2e/app.spec.ts",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "build:demo": "VITE_API_MODE=local npm run build -w @ledgerly/web",
    "start": "npm run start -w @ledgerly/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
